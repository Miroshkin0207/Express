{
  "redirects": [
    {
      "source": "/",
      "destination": "static/"
    }
  ]
  "headers": [
    {
      "source": "/(.*)",
      "headers": [ 
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "OPTIONS, GET, POST" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
